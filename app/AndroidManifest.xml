<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.seagull.carlauncher">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />

    <!-- 桌面 / 基础 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 悬浮窗（L1 镜像卡片 / L3 虚拟屏卡片） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        特权级权限（复刻蓝图 §5「硬前提」，与参考车联助手 AndroidManifest 逐条对齐）。
        所有这些是 signature|privileged 级：普通安装时申请也无害（不会授予），
        装成 /system/priv-app（或厂商特权白名单）后即可直接使用「把别的 App 的
        Activity 拉进私有虚拟屏 / 注入事件 / 停别人进程」这几条硬能力，不必每次
        绕 su。海鸥同时保留 su 兜底（RootOps/PrivClient），两条腿走路：
        特权在位走特权，不在位走 root，两条都断才彻底失败。
        普通应用安装时这些声明不产生任何副作用（未持有即不授予，无运行时风险）。
    -->
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.CAPTURE_SECURE_VIDEO_OUTPUT" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />

    <!-- 状态/设置类（root 或特权时才有意义，普通应用申请了也无害） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Seagull"
        android:supportsRtl="false">

        <!--
            LSPosed 模块声明（批次 W，见 XposedEntry）：让 LSPosed 管理器把本 APK
            列为模块。经典入口（assets/xposed_init → XposedEntry）。

            xposedminversion 是「本模块要求框架提供的 Xposed API 最低版本」，
            必须 <= 框架的 XposedBridge.getXposedVersion()，否则 LSPosed 直接跳过加载
            （模块在管理器里可见、作用域也在，但任何进程都进不去 —— 静默失效）。

            取值 82（批次 Y 放宽，之前是 93）：判据是「越低越兼容」——
            82 的可加载集合是 93 的**严格超集**：框架报 82 时只有 82 能过，
            框架报 93/102 时两者都过。我们的编译期签名桩本来就是 api-82
            （app/libs/xposed-api-82.jar），82 才是与桩一致的声明值。
            参考实现 com.leting 写 93 能跑，只说明 93 够用，不说明 93 最优。

            真机上还出现过「源码已改、产物没重建」导致 APK 里仍是旧值的情况
            （批次 X 复盘）—— 所以本文件改动后必须重新构建，光看源码不算。
        -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="海鸥桌面：高德 PiP 尺寸缩放(60%) + H1/H2/H3 窗口语义 + D段窄屏竖屏配置改写(网易云车机版) + 网易云跨屏 displayId 注入" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".HomeActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustNothing|stateUnchanged">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!--
                又当默认桌面（HOME）又给个图标进 app：没有这一条，装完只在系统「默认桌面」
                选择列表里出现，应用抽屉里不显示，想点进设置只能按 Home 键。
                HOME 与 LAUNCHER 两个 intent-filter 共存是允许的，默认桌面功能不受影响。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".SettingsHubActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".SettingsSectionActivity"
            android:exported="false"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".VirtualDisplayActivity"
            android:exported="false"
            android:label="@string/vd_title"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout" />

        <activity
            android:name=".RootPanelActivity"
            android:exported="false"
            android:label="@string/root_panel_title"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".WindowTestActivity"
            android:exported="false"
            android:label="@string/window_test_title"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".MirrorRequestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:label="@string/all_apps"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:label="搜索"
            android:windowSoftInputMode="adjustResize|stateVisible"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity android:name=".FolderActivity" android:exported="false"
            android:label="@string/folder_title" />
        <activity android:name=".LayoutModeActivity" android:exported="false"
            android:label="@string/layout_title" />
        <activity
            android:name=".MirrorActivity"
            android:exported="false"
            android:label="@string/mirror_title"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout" />

        <!-- 画中画锚点（批次 R，复刻 CarWithX PipAnchorActivity）：常驻虚拟屏的空 task，
             重钉落点 + 防空屏回收。excludeFromRecents + 独立 affinity + 透明主题。
             singleTask（批次 S）：NEW_TASK 复用锚点 task 时只保留一个实例 ——
             standard 模式下每次部署都会往锚点 task 里叠一个透明实例，永不 finish。 -->
        <activity
            android:name=".PipAnchorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.seagull.carlauncher.anchor"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".GardenActivity"
            android:exported="false"
            android:label="菜园"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout" />

        <service
            android:name=".BallService"
            android:exported="false" />

        <service
            android:name=".PipProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- L1 镜像卡片服务：持有 MediaProjection 卡片的生命周期。
             运行时以 FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION 调 startForeground，
             所以清单【必须】声明同名 type —— 不声明会抛
             MissingForegroundServiceTypeException（旧注释的说法是反的：
             声明不会炸，漏声明才会炸，异常被 catch 吞掉后服务进不了前台，随即被系统杀掉）。 -->
        <service
            android:name=".WindowService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".RootShellService"
            android:exported="false" />

        <!--
            APK 自更新：安装 intent 的 Uri 走 SeagullFileProvider（见同名 java，零依赖
            自绘 FileProvider）。targetSdk 33 下 Uri.fromFile() = FileUriExposedException。
        -->
        <provider
            android:name=".SeagullFileProvider"
            android:authorities="com.seagull.carlauncher.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
